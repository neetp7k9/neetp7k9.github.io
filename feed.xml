---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title><subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self"/><link href="{{ '/blog/' | absolute_url }}"/>
  <id>{{ '/blog/' | absolute_url }}</id><updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>Pu An Yang</name></author>
  {% for post in site.posts limit:20 %}<entry><title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url }}"/><id>{{ post.url | absolute_url }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{{ post.date | date_to_xmlschema }}</updated><summary>{{ post.summary | xml_escape }}</summary><content type="html">{{ post.content | xml_escape }}</content></entry>{% endfor %}
</feed>
